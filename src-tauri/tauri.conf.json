{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MicroHub",
  "version": "0.1.0",
  "identifier": "io.github.stimularity.microhub",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "windows": [
      {
        "title": "MicroHub Desktop",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "resources/runtime.tar.gz": "runtime.tar.gz",
      "resources/runtime.id": "runtime.id",
      "resources/app": "shinyapp"
    }
  }
}
